# iks/deploy.env.example
# Copy to iks/deploy.env and fill in your values.
# iks/deploy.env is gitignored — never commit it.
#
#   cp iks/deploy.env.example iks/deploy.env
#   nano iks/deploy.env
#   ./iks/deploy.sh

# ── Quay.io image registry ────────────────────────────────────────────────────
REGISTRY=quay.io/YOUR_QUAY_USERNAME

# ── IBM Cloud IKS cluster ─────────────────────────────────────────────────────
# Get cluster name from: ibmcloud ks clusters
# OR from IBM Cloud console → Kubernetes → Clusters
IKS_CLUSTER_NAME=worktrace

# ── Supabase (frontend build args — baked into the JS bundle) ─────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── In-cluster Postgres password ──────────────────────────────────────────────
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# ── Supabase Postgres (daily sync destination) ────────────────────────────────
SUPABASE_PG_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_POSTGRES_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBED_PROVIDER=nomic
NOMIC_API_KEY=YOUR_NOMIC_API_KEY
NOMIC_EMBED_MODEL=nomic-embed-text-v1.5
EMBED_DIMENSIONS=768

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=watsonx
WATSONX_API_KEY=YOUR_WATSONX_API_KEY
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=YOUR_WATSONX_PROJECT_ID
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ── Audio/Video transcription (Groq Whisper) ──────────────────────────────────
OPENAI_API_KEY=YOUR_GROQ_API_KEY
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_TOP_K=5

# ── LangChain toggle ──────────────────────────────────────────────────────────
USE_LANGCHAIN=true

# ── ML classifier toggle ──────────────────────────────────────────────────────
USE_LLM_CLASSIFY=true

# ── Admin users ───────────────────────────────────────────────────────────────
ADMIN_USER_IDS=YOUR_SUPABASE_USER_UUID
